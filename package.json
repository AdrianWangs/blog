{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "git-commit": "git add . && git commit -m",
    "git-push": "git push origin main",
    "publish": "npm run deploy && npm run git-commit \"Publish new post\" && npm run git-push",
    "update-algo-dir": "node scripts/update-algorithm-directory.js",
    "new-algo": "hexo new post $1 && npm run update-algo-dir"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "colorjs.io": "^0.5.2",
    "hexo": "^7.3.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-ai-summary": "^1.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index-pin-top": "^0.2.2",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-graph": "^1.0.13",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.3.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-symbols-count-time": "^0.7.1",
    "hexo-theme-landscape": "^1.0.0",
    "js-yaml": "^4.1.0",
    "moment": "^2.30.1",
    "stylus": "^0.64.0"
  }
}
